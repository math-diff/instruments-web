# Web3Forms access key — get yours at https://web3forms.com (free)
# Replace the placeholder with your real key, then restart the dev server.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=YOUR_ACCESS_KEY

# Canonical HTTPS origin shared by metadata, sitemap and contact redirects.
# Change ONLY after the custom domain is verified and attached in Vercel.
NEXT_PUBLIC_SITE_URL=https://jf-international.vercel.app

# Optional additional OLD hostnames, comma-separated; never add the canonical host.
# The original jf-international.vercel.app host redirects automatically after migration.
SITE_REDIRECT_HOSTS=

# Optional Search Console HTML verification for a URL-prefix property.
# A Domain property needs the DNS TXT record supplied by Google instead.
GOOGLE_SITE_VERIFICATION=

# Optional GA4. Analytics loads only after explicit visitor consent.
# Disable Enhanced Measurement automatic form/outbound/file events in GA4;
# this site sends its own allowlisted, PII-free events.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
